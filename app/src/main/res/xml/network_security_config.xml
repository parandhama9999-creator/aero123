<?xml version="1.0" encoding="utf-8"?>
<!--
    Encrypted traffic only, trusted against the phone's system certificates.
    No certificate pinning: Google rotates the certificates behind its APIs, and stale pins
    blocked every Gemini call on devices ("Pin verification failed").
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
