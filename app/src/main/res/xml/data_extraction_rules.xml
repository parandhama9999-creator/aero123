<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup / transfer rules for API 31 and above.

    The encrypted stores are excluded from both cloud backup and device-to-device transfer: their
    master key lives in the device keystore and is never backed up, so a restored copy cannot be
    decrypted and opening it throws or silently resets.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aerofast_prefs_secure.xml" />
        <exclude domain="sharedpref" path="aerofast_scan_cache.xml" />
        <exclude domain="sharedpref" path="aerofast_prefs.xml" />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aerofast_prefs_secure.xml" />
        <exclude domain="sharedpref" path="aerofast_scan_cache.xml" />
        <exclude domain="sharedpref" path="aerofast_prefs.xml" />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="cache/" />
    </device-transfer>
</data-extraction-rules>
