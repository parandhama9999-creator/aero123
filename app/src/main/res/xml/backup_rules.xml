<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules (API 30 and below; API 31+ uses data_extraction_rules.xml).

    The encrypted stores are deliberately excluded. EncryptedSharedPreferences is decrypted with a
    master key held in the device keystore, and keystore keys are NEVER backed up. Restoring the
    encrypted XML onto a new device therefore produces a file nothing can decrypt, and opening it
    throws or silently resets. Leaving them out means the user retypes the API key on a new device,
    which is the correct trade-off.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="aerofast_prefs_secure.xml" />
    <exclude domain="sharedpref" path="aerofast_scan_cache.xml" />
    <!-- Older builds kept the API key here before the encrypted store got its own filename -->
    <exclude domain="sharedpref" path="aerofast_prefs.xml" />
</full-backup-content>
